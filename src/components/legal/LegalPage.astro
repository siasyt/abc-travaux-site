---
// =========================================================
// 法律类页面通用模板（法律声明 / 隐私政策）
// 上：标题 + 更新日期（占满整行，长标题也不会挤到正文）
// 下：各章节内容
// =========================================================
import type { LegalPageText } from "../../i18n/pages/legal";

interface Props {
    page: LegalPageText;
}

const { page } = Astro.props;
---

<section class="section legal">
    <span class="watermark legal-watermark" aria-hidden="true">ABC</span>

    <div class="container legal-grid">
        <!-- 标题 -->
        <header class="legal-head">
            <span class="eyebrow">{page.eyebrow}</span>
            <h1 class="display-title legal-title">{page.title}</h1>
            <span class="legal-rule" aria-hidden="true"></span>
            <p class="legal-updated">{page.updated}</p>
            {page.note && <p class="legal-note">{page.note}</p>}
        </header>

        <!-- 正文 -->
        <div class="legal-body">
            {
                page.sections.map((s) => (
                    <article class="legal-section">
                        <h2>{s.title}</h2>
                        <div class="legal-content" set:html={s.html} />
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .legal-watermark {
        right: -3rem;
        top: -2rem;
    }

    .legal-grid {
        display: grid;
        gap: var(--space-lg);
    }

    /* ---------- 标题 ---------- */
    .legal-head {
        max-width: 900px;
    }

    .legal-title {
        margin-top: var(--space-sm);
        font-size: clamp(2rem, 5vw, 4rem);
        line-height: 1.05;
        overflow-wrap: break-word;
    }

    .legal-rule {
        display: block;
        width: min(100%, 420px);
        height: 1px;
        margin-block: var(--space-sm);
        background: var(--c-ink);
    }

    .legal-updated {
        font-size: var(--fs-small);
        font-style: italic;
        color: var(--c-grey);
    }

    .legal-note {
        max-width: 760px;
        margin-top: var(--space-sm);
        padding: 0.9rem 1rem;
        border-left: 2px solid var(--c-orange);
        background: var(--c-watermark);
        font-size: var(--fs-small);
        line-height: 1.7;
    }

    /* ---------- 正文 ---------- */
    .legal-body {
        display: grid;
        gap: var(--space-md);
        max-width: 760px;
    }

    .legal-section {
        padding-bottom: var(--space-md);
        border-bottom: 1px solid var(--c-line);
    }

    .legal-section:last-child {
        border-bottom: none;
    }

    .legal-section h2 {
        margin-bottom: 0.75rem;
        font-family: var(--f-display);
        font-size: clamp(1.2rem, 1.8vw, 1.45rem);
        font-weight: 600;
        letter-spacing: 0.02em;
    }

    .legal-content {
        font-size: 0.95rem;
        line-height: 1.85;
    }

    .legal-content :global(p + p),
    .legal-content :global(p + ul),
    .legal-content :global(ul + p) {
        margin-top: 0.75rem;
    }

    .legal-content :global(ul) {
        display: grid;
        gap: 0.3rem;
    }

    .legal-content :global(li) {
        position: relative;
        padding-left: 1.1rem;
    }

    .legal-content :global(li)::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.8em;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--c-orange);
    }

    .legal-content :global(a) {
        color: var(--c-orange-deep);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* ---------- 手机 ---------- */
    @media (max-width: 560px) {
        .legal-title {
            font-size: clamp(1.6rem, 8vw, 2.25rem);
        }
    }
</style>
