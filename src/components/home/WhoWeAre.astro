---
// =========================================================
// WHO WE ARE.（对应 PDF 第 2 页下半部分）
// 左：Logo + 横线 + 大标题（右对齐）
// 右：公司名 + 两段介绍，橙色高亮关键词
// =========================================================
import { getLangFromUrl } from "../../i18n/ui";
import { home } from "../../i18n/pages/home";

const lang = getLangFromUrl(Astro.url);
const c = home[lang].who;
---

<section class="section who" id="who-we-are">
    <div class="container who-grid">
        <!-- 左侧 -->
        <div class="who-left">
            <img
                class="who-logo"
                src="/images/brand/logo-abc.png"
                alt="ABC Travaux"
                width="2000"
                height="741"
                loading="lazy"
                data-reveal
            />
            <span
                class="who-rule"
                data-reveal
                data-reveal-delay="150"
                aria-hidden="true"></span>
            <h2 class="display-title who-title">
                <span data-reveal data-reveal-delay="250">{c.title[0]}</span>
                <span data-reveal data-reveal-delay="400">{c.title[1]}</span>
            </h2>
        </div>

        <!-- 右侧 -->
        <div class="who-right">
            <p class="who-company" data-reveal>{c.company}</p>
            {
                c.paragraphs.map((p, i) => (
                    <p
                        class="who-text"
                        data-reveal
                        data-reveal-delay={150 + i * 150}
                        set:html={p}
                    />
                ))
            }
        </div>
    </div>
</section>

<style>
    .who-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: clamp(2.5rem, 6vw, 6rem);
        align-items: end;
    }

    /* ---------- 左侧 ---------- */
    .who-left {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        text-align: right;
    }

    .who-logo {
        width: clamp(120px, 14vw, 180px);
        height: auto;
    }

    /* 横线：从右往左画出 */
    .who-rule {
        display: block;
        width: 100%;
        height: 1px;
        margin-block: var(--space-sm);
        background: var(--c-ink);
    }

    .who-rule[data-reveal] {
        opacity: 1;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 1.2s var(--ease);
    }

    .who-rule.is-visible {
        transform: scaleX(1);
    }

    .who-title {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        font-size: clamp(2.5rem, 5.5vw, 4.5rem);
        line-height: 1.05;
    }

    /* ---------- 右侧 ---------- */
    .who-company {
        margin-bottom: var(--space-sm);
        font-family: var(--f-display);
        font-size: clamp(1.4rem, 2.2vw, 1.9rem);
        letter-spacing: 0.08em;
        color: var(--c-ink);
    }

    .who-text {
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.85;
        color: var(--c-ink);
    }

    .who-text + .who-text {
        margin-top: var(--space-sm);
    }

    /* 橙色关键词（内容来自 set:html，所以用 :global） */
    .who-text :global(mark) {
        background: none;
        color: var(--c-orange);
        font-weight: 700;
    }

    /* 括号里的法规说明：灰色斜体 */
    .who-text :global(em) {
        font-weight: 500;
        color: var(--c-grey);
    }

    /* ---------- 手机端 ---------- */
    @media (max-width: 860px) {
        .who-grid {
            grid-template-columns: 1fr;
            gap: var(--space-md);
        }

        .who-left {
            align-items: flex-start;
            text-align: left;
        }

        .who-title {
            align-items: flex-start;
        }

        .who-rule[data-reveal] {
            transform-origin: left;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .who-rule[data-reveal] {
            transform: none;
        }
    }
</style>
