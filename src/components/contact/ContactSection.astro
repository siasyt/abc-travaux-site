---
// =========================================================
// 联系页
// 左：标题 + 引言 + 联系方式（地址 / 电话 / 邮箱 / 微信）
// 右：报价表单
// 下：地图
//
// 防垃圾信息（4 层）：
//   1. 蜜罐字段：机器人会勾选隐藏的勾选框
//   2. hCaptcha 人机验证（填了 Web3Forms 密钥后才启用）
//   3. 填写时间检测：打开页面不到 3 秒就提交的视为机器人
//   4. 字数上限 + 项目描述最多 2 个链接 + 发送后 60 秒内不能重复提交
// =========================================================
import { getLangFromUrl, site } from "../../i18n/ui";
import { contact } from "../../i18n/pages/contact";
import { WEB3FORMS_ACCESS_KEY } from "../../data/config";

const lang = getLangFromUrl(Astro.url);
const c = contact[lang];
const f = c.form;

const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.country}`;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;

// 是否已经配置了 Web3Forms（配置后才显示人机验证）
const hasKey = WEB3FORMS_ACCESS_KEY.trim() !== "";
---

<section class="section contact" id="contact">
    <span class="watermark contact-watermark" aria-hidden="true">ABC</span>

    <div class="container contact-grid">
        <!-- ========== 左侧：标题 + 联系方式 ========== -->
        <div class="contact-info">
            <span class="eyebrow" data-reveal>{c.eyebrow}</span>
            <h1 class="display-title contact-title">
                <span data-reveal data-reveal-delay="100">{c.title[0]}</span>
                <span data-reveal data-reveal-delay="200">{c.title[1]}</span>
            </h1>
            <span class="contact-rule" aria-hidden="true"></span>
            <p class="contact-lead" data-reveal data-reveal-delay="300">
                {c.lead}
            </p>

            <ul class="contact-list" data-reveal data-reveal-delay="400">
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"
                        ></path>
                        <circle cx="12" cy="9.5" r="2.5"></circle>
                    </svg>
                    <div>
                        <span class="contact-label">{c.info.address}</span>
                        <a href={mapLink} target="_blank" rel="noopener">
                            {site.address.street}<br />{site.address.city}, {
                                site.address.country
                            }
                        </a>
                    </div>
                </li>
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"
                        ></path>
                    </svg>
                    <div>
                        <span class="contact-label">{c.info.phone}</span>
                        <a href={site.phoneHref}>{site.phone}</a>
                    </div>
                </li>
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                        <path d="m3 7 9 6 9-6"></path>
                    </svg>
                    <div>
                        <span class="contact-label">{c.info.email}</span>
                        <a href={`mailto:${site.email}`}>{site.email}</a>
                    </div>
                </li>
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            d="M9.5 4C5.4 4 2 6.8 2 10.2c0 1.9 1 3.6 2.7 4.7L4 17.5l2.9-1.5c.8.2 1.7.4 2.6.4"
                        ></path>
                        <path
                            d="M15.5 9c3.6 0 6.5 2.4 6.5 5.4 0 1.6-.9 3-2.3 4l.5 2.1-2.4-1.3c-.7.2-1.5.3-2.3.3-3.6 0-6.5-2.4-6.5-5.4S11.9 9 15.5 9Z"
                        ></path>
                    </svg>
                    <div>
                        <span class="contact-label">{c.info.wechat}</span>
                        <span>{site.wechat}</span>
                    </div>
                </li>
            </ul>
        </div>

        <!-- ========== 右侧：表单 ========== -->
        <form
            class="contact-form"
            data-contact-form
            data-key={WEB3FORMS_ACCESS_KEY}
            data-to={site.email}
            data-subject={f.subject}
            data-msg-sending={f.sending}
            data-msg-success={f.success}
            data-msg-error={f.error}
            data-msg-mailto={f.mailtoNotice}
            data-msg-captcha={f.captchaRequired}
            data-msg-links={f.tooManyLinks}
            data-msg-wait={f.wait}
            data-reveal
            data-reveal-delay="200"
            novalidate
        >
            <h2 class="form-title">{f.title}</h2>
            <p class="form-required"><span class="req">*</span> {f.required}</p>

            <!-- 防机器人：真人看不到这个勾选框 -->
            <input
                type="checkbox"
                name="botcheck"
                class="hp"
                tabindex="-1"
                autocomplete="off"
            />

            <div class="form-row">
                <label class="field">
                    <span>{f.name} <span class="req">*</span></span>
                    <input
                        type="text"
                        name="name"
                        autocomplete="name"
                        maxlength="80"
                        required
                    />
                </label>
                <label class="field">
                    <span>{f.company}</span>
                    <input
                        type="text"
                        name="company"
                        autocomplete="organization"
                        maxlength="100"
                    />
                </label>
            </div>

            <div class="form-row">
                <label class="field">
                    <span>{f.email} <span class="req">*</span></span>
                    <input
                        type="email"
                        name="email"
                        autocomplete="email"
                        maxlength="120"
                        required
                    />
                </label>
                <label class="field">
                    <span>{f.phone}</span>
                    <input
                        type="tel"
                        name="phone"
                        autocomplete="tel"
                        maxlength="30"
                    />
                </label>
            </div>

            <div class="form-row">
                <label class="field">
                    <span>{f.type} <span class="req">*</span></span>
                    <select name="project_type" required>
                        <option value="" disabled selected
                            >{f.typePlaceholder}</option
                        >
                        {
                            f.typeOptions.map((opt) => (
                                <option value={opt}>{opt}</option>
                            ))
                        }
                    </select>
                </label>
                <label class="field">
                    <span>{f.location}</span>
                    <input
                        type="text"
                        name="location"
                        autocomplete="address-level2"
                        maxlength="80"
                    />
                </label>
            </div>

            <label class="field">
                <span>{f.message} <span class="req">*</span></span>
                <textarea
                    name="message"
                    rows="5"
                    placeholder={f.messagePlaceholder}
                    minlength="10"
                    maxlength="3000"
                    required></textarea>
            </label>

            <label class="consent">
                <input type="checkbox" name="consent" required />
                <span>{f.consent} <span class="req">*</span></span>
            </label>

            <!-- hCaptcha 人机验证（由 Web3Forms 提供，免费） -->
            {
                hasKey && (
                    <div
                        class="h-captcha"
                        data-captcha="true"
                        data-theme="dark"
                        data-lang={lang === "zh" ? "zh-CN" : "fr"}
                    />
                )
            }

            <button type="submit" class="btn btn--primary form-submit">
                <span data-submit-label>{f.submit}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"
                    ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
                >
            </button>

            <p
                class="form-status"
                data-form-status
                role="status"
                aria-live="polite"
            >
            </p>
        </form>
    </div>
</section>

<!-- ========== 地图 ========== -->
<section class="contact-map" aria-label={c.info.address}>
    <iframe
        src={mapSrc}
        title={fullAddress}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
</section>

<!-- hCaptcha 脚本：只有配置了密钥才加载 -->
{
    hasKey && (
        <script
            is:inline
            src="https://web3forms.com/client/script.js"
            async
            defer
        />
    )
}

<script>
    const MIN_FILL_MS = 3000; // 少于 3 秒提交 = 机器人
    const MAX_LINKS = 2; // 项目描述最多允许的链接数
    const COOLDOWN_MS = 60_000; // 两次提交之间至少间隔 60 秒
    const STORAGE_KEY = "abc-contact-last-sent";

    function initContactForm() {
        const form = document.querySelector<HTMLFormElement>(
            "[data-contact-form]",
        );
        if (!form) return;

        const status = form.querySelector<HTMLElement>("[data-form-status]")!;
        const label = form.querySelector<HTMLElement>("[data-submit-label]")!;
        const submitBtn =
            form.querySelector<HTMLButtonElement>(".form-submit")!;
        const d = form.dataset;
        const defaultLabel = label.textContent ?? "";
        const openedAt = Date.now(); // 页面打开的时间

        // 读取 / 记录上次发送时间（浏览器禁止存储时不报错）
        const getLastSent = () => {
            try {
                return Number(sessionStorage.getItem(STORAGE_KEY) ?? 0);
            } catch {
                return 0;
            }
        };
        const setLastSent = () => {
            try {
                sessionStorage.setItem(STORAGE_KEY, String(Date.now()));
            } catch {
                /* 忽略 */
            }
        };

        const setStatus = (text: string, type: "ok" | "err" | "" = "") => {
            status.textContent = text;
            status.className = `form-status ${type ? `is-${type}` : ""}`;
        };

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            // 浏览器自带的必填 / 邮箱格式校验
            if (!form.checkValidity()) {
                form.classList.add("was-validated");
                form.reportValidity();
                return;
            }

            const data = new FormData(form);

            // 防护 1：蜜罐被勾选 → 机器人，假装成功，什么都不发
            // 防护 3：打开页面不到 3 秒就提交 → 机器人，同样假装成功
            if (data.get("botcheck") || Date.now() - openedAt < MIN_FILL_MS) {
                form.reset();
                setStatus(d.msgSuccess ?? "", "ok");
                return;
            }

            // 防护 4：60 秒内重复提交
            if (Date.now() - getLastSent() < COOLDOWN_MS) {
                setStatus(d.msgWait ?? "", "err");
                return;
            }

            const fields = {
                name: String(data.get("name") ?? ""),
                company: String(data.get("company") ?? ""),
                email: String(data.get("email") ?? ""),
                phone: String(data.get("phone") ?? ""),
                project_type: String(data.get("project_type") ?? ""),
                location: String(data.get("location") ?? ""),
                message: String(data.get("message") ?? "").trim(),
            };

            // 防护 4：链接太多（垃圾广告的典型特征）
            const links = fields.message.match(/(https?:\/\/|www\.)/gi) ?? [];
            if (links.length > MAX_LINKS) {
                setStatus(d.msgLinks ?? "", "err");
                return;
            }

            // ---------- 还没有密钥：打开访客的邮件软件 ----------
            if (!d.key) {
                const body = [
                    `${fields.name}${fields.company ? ` — ${fields.company}` : ""}`,
                    `Email : ${fields.email}`,
                    fields.phone ? `Tel : ${fields.phone}` : null,
                    `Projet / 项目 : ${fields.project_type}${fields.location ? ` — ${fields.location}` : ""}`,
                    "",
                    fields.message,
                ]
                    .filter((line) => line !== null)
                    .join("\n");

                setStatus(d.msgMailto ?? "", "ok");
                setLastSent();
                window.location.href = `mailto:${d.to}?subject=${encodeURIComponent(d.subject ?? "")}&body=${encodeURIComponent(body)}`;
                return;
            }

            // ---------- 有密钥：通过 Web3Forms 直接发送 ----------

            // 防护 2：hCaptcha 必须完成
            const captcha = form.querySelector<HTMLTextAreaElement>(
                "textarea[name=h-captcha-response]",
            );
            if (!captcha || !captcha.value) {
                setStatus(d.msgCaptcha ?? "", "err");
                return;
            }

            submitBtn.disabled = true;
            label.textContent = d.msgSending ?? "";
            setStatus("");

            try {
                const res = await fetch("https://api.web3forms.com/submit", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Accept: "application/json",
                    },
                    body: JSON.stringify({
                        access_key: d.key,
                        subject: d.subject,
                        from_name: "ABC Travaux — Site web",
                        replyto: fields.email,
                        ...fields,
                        "h-captcha-response": captcha.value,
                    }),
                });
                const json = await res.json();
                if (!json.success) throw new Error(json.message);

                form.reset();
                form.classList.remove("was-validated");
                setLastSent();
                setStatus(d.msgSuccess ?? "", "ok");
            } catch {
                setStatus(d.msgError ?? "", "err");
            } finally {
                submitBtn.disabled = false;
                label.textContent = defaultLabel;
                // 每次提交后重置人机验证，下一次需要重新验证
                (window as any).hcaptcha?.reset?.();
            }
        });
    }

    initContactForm();
</script>

<style>
    .contact-watermark {
        right: -3rem;
        top: -2rem;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: clamp(2.5rem, 6vw, 6rem);
        align-items: start;
    }

    /* ---------- 左侧 ---------- */
    .contact-title {
        display: flex;
        flex-direction: column;
        margin-top: var(--space-sm);
        font-size: clamp(2.5rem, 5vw, 4.25rem);
        line-height: 1.05;
    }

    .contact-rule {
        display: block;
        height: 1px;
        margin-block: var(--space-sm) var(--space-md);
        background: var(--c-ink);
    }

    .contact-lead {
        font-size: 0.95rem;
        font-weight: 700;
        font-style: italic;
        line-height: 1.7;
    }

    .contact-list {
        display: grid;
        gap: 1.25rem;
        margin-top: var(--space-lg);
    }

    .contact-list li {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .contact-list svg {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        padding: 9px;
        border-radius: 50%;
        background: var(--c-watermark);
        fill: none;
        stroke: var(--c-orange-deep);
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .contact-list div {
        display: flex;
        flex-direction: column;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .contact-label {
        font-size: var(--fs-eyebrow);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--c-grey);
    }

    .contact-list a {
        transition: color 0.3s var(--ease);
    }

    .contact-list a:hover {
        color: var(--c-orange-deep);
    }

    /* ---------- 表单 ---------- */
    .contact-form {
        display: grid;
        gap: 1.1rem;
        padding: clamp(1.5rem, 3.5vw, 2.75rem);
        border-radius: 14px;
        background: var(--c-brown);
        color: var(--c-white);
    }

    .form-title {
        font-family: var(--f-display);
        font-size: clamp(1.5rem, 2.4vw, 2rem);
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .form-required {
        margin-top: -0.6rem;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.6);
    }

    .req {
        color: var(--c-orange);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.1rem;
    }

    .field {
        display: grid;
        gap: 0.4rem;
        font-size: var(--fs-small);
        font-weight: 600;
    }

    .field input,
    .field select,
    .field textarea {
        width: 100%;
        padding: 0.8rem 0.95rem;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.06);
        font: inherit;
        font-weight: 400;
        color: var(--c-white);
        transition:
            border-color 0.3s var(--ease),
            background 0.3s var(--ease);
    }

    .field textarea {
        resize: vertical;
        min-height: 130px;
    }

    .field select option {
        color: var(--c-ink);
    }

    .field input::placeholder,
    .field textarea::placeholder {
        color: rgba(255, 255, 255, 0.4);
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
        outline: none;
        border-color: var(--c-orange);
        background: rgba(255, 255, 255, 0.1);
    }

    /* 提交后才显示红框，避免一打开页面就满屏报错 */
    .was-validated :is(input, select, textarea):invalid {
        border-color: #ff6b6b;
    }

    .consent {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.8rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.75);
        cursor: pointer;
    }

    .consent input {
        flex-shrink: 0;
        width: 18px;
        height: 18px;
        margin-top: 0.15rem;
        accent-color: var(--c-orange-deep);
    }

    /* hCaptcha 验证框 */
    .h-captcha {
        min-height: 78px;
    }

    .form-submit {
        justify-self: start;
        margin-top: 0.4rem;
    }

    .form-submit svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: transform 0.4s var(--ease);
    }

    .form-submit:hover svg {
        transform: translateX(4px);
    }

    .form-submit:hover {
        color: var(--c-white);
        border-color: var(--c-white);
    }

    .form-submit:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    .form-status {
        min-height: 1.5em;
        font-size: var(--fs-small);
        font-weight: 600;
    }

    .form-status.is-ok {
        color: var(--c-orange-light);
    }

    .form-status.is-err {
        color: #ff8f8f;
    }

    /* 防机器人字段：隐藏 */
    .hp {
        position: absolute;
        left: -9999px;
        opacity: 0;
    }

    /* ---------- 地图 ---------- */
    .contact-map {
        height: clamp(320px, 45vw, 480px);
        border-top: 1px solid var(--c-orange);
    }

    .contact-map iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
        filter: grayscale(0.85) contrast(1.05);
        transition: filter 0.6s var(--ease);
    }

    .contact-map:hover iframe {
        filter: none;
    }

    /* ---------- 平板 / 手机 ---------- */
    @media (max-width: 960px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 560px) {
        .form-row {
            grid-template-columns: 1fr;
        }

        .form-submit {
            justify-self: stretch;
            justify-content: center;
        }
    }
</style>
